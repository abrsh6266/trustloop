generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AgreementStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ParticipantRole {
  CREATOR
  PARTICIPANT
}

enum ObligationStatus {
  PENDING
  DONE
  FAILED
}

enum ActivityAction {
  CREATED
  UPDATED
  COMPLETED
  FAILED
}

model User {
  id                  String                 @id @db.Uuid
  email               String                 @unique
  name                String?
  trustScore          Float                  @default(100) @map("trust_score")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  agreementsCreated   Agreement[]            @relation("CreatedAgreements")
  agreementMembers    AgreementParticipant[]
  assignedObligations Obligation[]           @relation("AssignedObligations")
  activityLogs        ActivityLog[]

  @@map("users")
}

model Agreement {
  id           String                 @id @default(cuid())
  title        String
  description  String
  createdById  String                 @map("created_by_id") @db.Uuid
  createdBy    User                   @relation("CreatedAgreements", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  dueDate      DateTime               @map("due_date")
  status       AgreementStatus        @default(PENDING)
  participants AgreementParticipant[]
  obligations  Obligation[]
  activityLogs ActivityLog[]

  @@index([createdById])
  @@index([status])
  @@map("agreements")
}

model AgreementParticipant {
  id          String          @id @default(cuid())
  agreementId String          @map("agreement_id")
  userId      String          @map("user_id") @db.Uuid
  role        ParticipantRole @default(PARTICIPANT)
  createdAt   DateTime        @default(now()) @map("created_at")
  agreement   Agreement       @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agreementId, userId])
  @@index([userId])
  @@map("agreement_participants")
}

model Obligation {
  id           String           @id @default(cuid())
  agreementId  String           @map("agreement_id")
  assignedToId String           @map("assigned_to_id") @db.Uuid
  description  String
  status       ObligationStatus @default(PENDING)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  agreement    Agreement        @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  assignedTo   User             @relation("AssignedObligations", fields: [assignedToId], references: [id], onDelete: Cascade)

  @@index([agreementId])
  @@index([assignedToId])
  @@map("obligations")
}

model ActivityLog {
  id          String         @id @default(cuid())
  agreementId String         @map("agreement_id")
  action      ActivityAction
  userId      String         @map("user_id") @db.Uuid
  details     String?
  timestamp   DateTime       @default(now())
  agreement   Agreement      @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([agreementId, timestamp])
  @@map("activity_logs")
}
